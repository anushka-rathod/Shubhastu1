{
  "version": 2,
  "name": "shubhashtufashion",
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,services/**,*.py,database.sqlite}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}