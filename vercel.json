{
  "version": 2,
  "name": "shubhashtufashion",
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,services/**,*.py,database.sqlite}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
