# ==============================================================================
# SHUBHASHTU FASHION - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# 1. SERVER & SECURITY SECRETS
PORT=8000
DEBUG=False
SECRET_KEY=shubhashtu-super-secret-key-2026-luxury-fashion-store
COOKIE_SECRET=shubhashtu-cookie-secret-token-gold-blush-98432

# 2. CLOUD DATABASE (Vercel Production - Permanent Data Persistence)
# Local dev automatically uses SQLite database.sqlite.
# For Vercel production deployment, provide a free cloud PostgreSQL connection string:
# (Supabase, Neon DB, Railway, or AWS RDS):
# Example: postgresql://postgres.xxxx:YourPassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# 3. CLOUDINARY CDN (Product Image Uploads - Zero Disk Writes)
# Free 25GB cloud CDN for artisan jewelry & hand-painted garment photos.
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. BRAND & WHATSAPP SALES DETAILS
BRAND_NAME=Shubhashtu Fashion
BRAND_TAGLINE="Style That Speaks for You."
SUPPORT_PHONE="+91 98765 43210"
SUPPORT_WHATSAPP=919876543210
SUPPORT_EMAIL=care@shubhashtufashion.com
STORE_ADDRESS="Shubhashtu Studio, 402 Heritage Galleria, M.G. Road, Bengaluru, Karnataka - 560001"
STORE_UPI_ID=shubhashtu@upi

# 5. SUPER ADMIN LOGIN CREDENTIALS
ADMIN_EMAIL=admin@shubhashtu.com
ADMIN_PASSWORD=ShubhashtuAdmin@2026

# 6. SHIPROCKET LOGISTICS & COURIER (Optional - uses automated store rules when blank)
# Register at: https://app.shiprocket.in/
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=560001

# 7. EMAIL NOTIFICATIONS (SMTP - Optional)
# Use Gmail App Password or your domain mail server (e.g. Hostinger, Zoho, AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Shubhashtu Fashion <orders@shubhashtufashion.com>"

# 8. AI FASHION STYLIST & CONCIERGE (Optional)
# For Vercel AI SDK generative styling conversations & sizing recommendations:
GEMINI_API_KEY=
OPENAI_API_KEY=
